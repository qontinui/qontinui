# The facade's GPU runtime, installed into the llama-swap image's /opt/venvs/imagegen from
# the hash-locked requirements-runtime.txt (docker/llama-swap/Dockerfile). Every component
# manifest.yaml lists as a library is pinned here at the manifest's version, and
# tests/test_facade_config.py checks the lock carries the manifest's wheel sha256 for each.
# Regenerate the lock after any change here (target: the venv's uv-managed CPython 3.12 on
# Ubuntu 22.04, x86_64 -- manifest.yaml `target`):
#   uv pip compile requirements-runtime.in --python-version 3.12 \
#     --python-platform x86_64-manylinux_2_28 --generate-hashes \
#     --index-strategy unsafe-best-match \
#     --extra-index-url https://download.pytorch.org/whl/cu128 --emit-index-url \
#     -o requirements-runtime.txt
diffusers==0.41.0
transformers==5.19.0
accelerate==1.15.0
safetensors==0.8.0
torch==2.11.0+cu128
torchvision==0.26.0+cu128
timm==1.0.30
kornia==0.8.2
einops==0.8.2
vtracer==0.6.15
fastapi==0.142.2
starlette==1.7.0
uvicorn==0.54.0
python-multipart==0.0.32
# General-purpose runtime dependencies (outside D2's component scope; see manifest.yaml
# `scope`): image I/O, the YAML loader, the install's Hub client, and the cv2 BEN2 imports.
# Pillow decodes caller-supplied images: floored at 13.0.0, the release that fixes the
# advisories against 12.x (it requires Python >=3.11, hence the venv's 3.12).
pillow>=13
pyyaml
huggingface-hub
opencv-python-headless
numpy
# Advisory floors on packages the runtime only gets transitively. uv keeps the existing
# lock's pins when it regenerates, so a fixed release reaches requirements-runtime.txt only
# through a floor here: certifi (GHSA-6q48-6c7w-9gw2, fixed in 2026.10.18) and filelock
# (fixed in 4.2.1, which requires Python >=3.11).
certifi>=2026.10.18
filelock>=4.2.1
# The IANA zone database for the bulk window's clock (zoneinfo); the CUDA base image
# does not install the distro tzdata package.
tzdata
